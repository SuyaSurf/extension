{
  "manifest_version": 3,
  "name": "SuyaSurf Chrome Assistant",
  "version": "1.0.0",
  "description": "Comprehensive AI assistant with 15+ specialized skills for background tasks, server integration, mail management, content creation, and more",
  
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "scripting",
    "offscreen",
    "downloads",
    "clipboardWrite",
    "notifications",
    "tabCapture",
    "contextMenus",
    "identity"
  ],
  
  "host_permissions": [
    "https://*.gmail.com/*",
    "https://mail.google.com/*",
    "https://*.outlook.com/*",
    "https://*.venmail.com/*",
    "https://web.telegram.org/*",
    "https://web.whatsapp.com/*",
    "https://docs.google.com/*",
    "https://slides.google.com/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://rsvp.withgoogle.com/*",
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],

  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.gmail.com/*",
        "https://mail.google.com/*",
        "https://*.outlook.com/*",
        "https://*.venmail.com/*",
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://docs.google.com/*",
        "https://slides.google.com/*",
        "https://*.youtube.com/*",
        "https://rsvp.withgoogle.com/*"
      ],
      "js": ["content-scripts/universal-handler.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.gmail.com/*",
        "https://mail.google.com/*",
        "https://*.outlook.com/*",
        "https://*.venmail.com/*",
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://docs.google.com/*",
        "https://slides.google.com/*",
        "https://*.youtube.com/*",
        "https://rsvp.withgoogle.com/*"
      ],
      "js": [
        "vendors/vendors.bundle.js",
        "common/common.bundle.js",
        "content-script/content-script.bundle.js"
      ],
      "run_at": "document_idle"
    }
  ],
  
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI Bot Extension",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "shared/*",
        "shared/*/*",
        "skills/application-writing/*",
        "skills/application-writing/utils/*",
        "skills/qa-testing/*",
        "chunks/*",
        "vendors/*",
        "common/*",
        "content-script/*",
        "ui/review-scheduler.html",
        "ui/review-scheduler.js"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
